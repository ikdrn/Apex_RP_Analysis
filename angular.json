{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "apex-rp-analysis": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/apex-rp-analysis",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "node_modules/@fontsource/chakra-petch/latin-500.css",
              "node_modules/@fontsource/chakra-petch/latin-600.css",
              "node_modules/@fontsource/chakra-petch/latin-700.css",
              "node_modules/@fontsource/jetbrains-mono/latin-400.css",
              "node_modules/@fontsource/jetbrains-mono/latin-500.css",
              "node_modules/@fontsource/jetbrains-mono/latin-600.css",
              "node_modules/@fontsource/noto-sans-jp/400.css",
              "node_modules/@fontsource/noto-sans-jp/500.css",
              "node_modules/@fontsource/noto-sans-jp/700.css",
              "src/styles/global.scss"
            ],
            "scripts": [],
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "optimization": true,
            "sourceMap": false,
            "namedChunks": false,
            "extractLicenses": true
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "apex-rp-analysis:build"
          }
        }
      }
    }
  },
  "defaultProject": "apex-rp-analysis",
  "cli": {
    "analytics": false
  }
}
